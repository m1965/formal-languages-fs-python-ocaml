%{
open FormalLanguages.Lalr
%}
%token <float> NUMBER
%token PLUS MINUS TIMES DIVIDE POWER LPAREN RPAREN EOF
%start main
%type <FormalLanguages.Lalr.Expression> main
%%
main: expr EOF { $1 }
expr:
  | expr PLUS expr { Binary ("+", $1, $3) }
  | expr TIMES expr { Binary ("*", $1, $3) }
  | NUMBER { Number $1 }
