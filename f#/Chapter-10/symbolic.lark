statement: ID ":=" expr ";"
         | expr ";"

expr: expr ("+" | "-") product
    | product

product: product ("*" | "/") factor
       | factor

factor: "(" expr ")"    %ignore "(", ")"
      | NUMBER
      | ID

NUMBER: /(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?/
ID:     /[a-zA-Z][a-zA-Z0-9_]*/

%import common.WS
%ignore WS
