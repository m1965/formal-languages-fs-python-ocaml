// A solution of the exercise of Interpreter-Frame.ipynb: the grammar sl-frame.lark,
// extended by for loops, function definitions, return statements, and the logical
// operators ||, &&, and !.

program: stmnt*

stmnt: "if" "(" bool_expr ")" "{" program "}"
     | "while" "(" bool_expr ")" "{" program "}"
     | "for" "(" assign ";" bool_expr ";" assign ")" "{" program "}"
     | "function" ID "(" parameters ")" "{" program "}"
     | "return" expr ";"
     | assign ";"
     | expr ";"                           -> "expr"

parameters: [ID ("," ID)*]                -> "parameters"

assign: ID ":=" expr

bool_expr: bool_expr "||" conjunction
         | conjunction

conjunction: conjunction "&&" negation
           | negation

negation: "!" negation
        | bool_atom

bool_atom: expr ("==" | "!=" | "<=" | ">=" | "<" | ">") expr
         | "(" bool_expr ")"

expr: expr ("+" | "-") product
    | product

product: product ("*" | "/" | "%") factor
       | factor

factor: "(" expr ")"
      | INT
      | FLOAT
      | STRING
      | ID
      | ID "(" [expr ("," expr)*] ")" -> "call"

// These literals are left out of the heads of all tuples.
%ignore: "(", ")", "{", "}", ";"

// Lexical definitions
%import common.CNAME -> ID, common.WS, common.CPP_COMMENT, common.C_COMMENT

FLOAT:  /[0-9](_?[0-9])*\.[0-9](_?[0-9])*([eE][+-]?[0-9]+)?/
INT:    /[0-9](_?[0-9])*/
STRING: /"(\\.|[^"\\])*"/

// Ignore whitespace and comments
%ignore WS, C_COMMENT, CPP_COMMENT
