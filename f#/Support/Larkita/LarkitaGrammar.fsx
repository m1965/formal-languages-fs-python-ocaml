/// Larkita for F#, part 6: the grammar loader (load_grammar.py).
///
/// A grammar file is parsed with a canonical LR(1) parser for the grammar of grammars, which is
/// itself generated by Larkita.  The parse tree is then transformed step by step, in the same order
/// as in the Python version, so that the auxiliary rules and the anonymous terminals get the same names.
module LarkitaGrammar

#load "LarkitaBase.fsx" "LarkitaLexer.fsx" "LarkitaLr.fsx"

open System
open System.Collections.Generic
open System.Globalization
open System.Text
open LarkitaBase
open LarkitaLexer
open LarkitaLr

// ---------- Trees ----------

/// The parse trees of grammar files.  The trees are changed in place, and some subtrees are shared,
/// as in Python; Uid plays the role of Python's id().
[<NoEquality; NoComparison>]
type GNode =
    | T of GTree
    | Tk of Token
    | Sy of Symbol
    | Pt of Pattern
    | Sp of AstSpec

and [<NoEquality; NoComparison>] GTree = { mutable Data: string; mutable Children: GNode list; Uid: int }

let rec nodeEqual (a: GNode) (b: GNode) =
    match a, b with
    | T x, T y -> obj.ReferenceEquals(x, y) || (x.Data = y.Data && List.length x.Children = List.length y.Children && List.forall2 nodeEqual x.Children y.Children)
    | Tk x, Tk y -> x.Type = y.Type && x.Value = y.Value
    | Sy x, Sy y -> symbolEqual x y
    | Pt x, Pt y -> patternEqual x y
    | Sp x, Sp y -> x.SpecId = y.SpecId
    | _ -> false

let mutable private uidCounter = 0

let mk (data: string) (children: GNode list) =
    uidCounter <- uidCounter + 1
    { Data = data; Children = children; Uid = uidCounter }

let mkt data children = T(mk data children)

/// Depth-first iteration, bottom-up (Tree.iter_subtrees)
let iterSubtrees (t: GTree) : GTree list =
    let processed = HashSet<int>()
    let order = ResizeArray<GTree>()
    let queue = Queue<GTree>()
    queue.Enqueue t
    while queue.Count > 0 do
        let sub = queue.Dequeue()
        if processed.Add sub.Uid then
            order.Add sub
            for c in List.rev sub.Children do
                match c with
                | T c when not (processed.Contains c.Uid) -> queue.Enqueue c
                | _ -> ()
    order |> Seq.rev |> List.ofSeq

/// Tree.iter_subtrees_topdown
let iterSubtreesTopdown (t: GTree) : GTree list =
    let result = ResizeArray<GTree>()
    let rec go n =
        match n with
        | T t ->
            result.Add t
            List.iter go t.Children
        | _ -> ()
    go (T t)
    List.ofSeq result

let findData (t: GTree) (d: string) = iterSubtrees t |> List.filter (fun s -> s.Data = d)

let rec scanValues (pred: GNode -> bool) (t: GTree) : GNode list =
    t.Children |> List.collect (fun c -> match c with T s -> scanValues pred s | v -> if pred v then [ v ] else [])

let expandKidsByData (t: GTree) (datas: string list) =
    let mutable changed = false
    t.Children <-
        t.Children |> List.collect (fun c ->
            match c with
            | T s when List.contains s.Data datas ->
                changed <- true
                s.Children
            | c -> [ c ])
    changed

let rec copyTree (t: GTree) : GTree = mk t.Data (List.map copyNode t.Children)
and copyNode (n: GNode) = match n with T t -> T(copyTree t) | v -> v

/// Transformer_InPlace: the children of every subtree are transformed, bottom-up
let transformInPlace (f: GTree -> GNode) (t: GTree) : GNode =
    for sub in iterSubtrees t do
        sub.Children <- sub.Children |> List.map (fun c -> match c with T s -> f s | v -> v)
    f t

/// Transformer (recursive, creates new results)
let rec transform (f: string -> GNode list -> GNode) (n: GNode) : GNode =
    match n with
    | T t -> f t.Data (List.map (transform f) t.Children)
    | v -> v

let tokValue n = match n with Tk t -> t.Value | _ -> failwith "Larkita: token expected"
let treeOf n = match n with T t -> t | _ -> failwith "Larkita: tree expected"

let replaceAll (sub: string) (by: string) (s: string) = s.Replace(sub, by)

// ---------- The grammar of grammars ----------

let reFlags = "imslux"

let metaTerminals =
    [ "_LPAR", @"\("; "_RPAR", @"\)"; "_LBRA", @"\["; "_RBRA", @"\]"
      "OP", "[+*]|[?](?![a-z_])"; "_COLON", ":"; "_COMMA", ","; "_OR", @"\|"; "_DOT", @"\.(?!\.)"
      "_DOTDOT", @"\.\."; "TILDE", "~"; "RULE_MODIFIERS", "(!|![?]?|[?]!?)(?=[_a-z])"
      "RULE", "_?[a-z][_a-z0-9]*"; "TERMINAL", "_?[A-Z][_A-Z0-9]*"; "STRING", "\"(\\\\\"|\\\\\\\\|[^\"\\n])*?\"i?"
      "REGEXP", sprintf @"/(?!/)(\\/|\\\\|[^/])*?/[%s]*" reFlags; "_NL", @"(\r?\n)+\s*"
      "_NL_OR", @"(\r?\n)+\s*\|"; "WS", @"[ \t]+"; "COMMENT", @"\s*//[^\n]*|\s*#[^\n]*"
      "BACKSLASH", @"\\[ ]*\n"; "_TO", "->"; "_IGNORE", "%ignore"; "_OVERRIDE", "%override"
      "_DECLARE", "%declare"; "_EXTEND", "%extend"; "_IMPORT", "%import"; "NUMBER", @"[+-]?\d+" ]

/// The meta-grammar uses Lark's tree-shaping conventions: rules whose name starts with "?" are
/// replaced by their child if they have only one, rules whose name starts with "_" are inlined into
/// their parent, and terminals whose name starts with "_" are filtered out.
let metaRules =
    [ "start", [ "_list" ]
      "_list", [ "_item"; "_list _item" ]
      "_item", [ "rule"; "term"; "ignore"; "ast_ignore"; "import"; "declare"; "override"; "extend"; "_NL" ]
      "rule", [ "rule_modifiers RULE priority _COLON expansions _NL" ]
      "rule_modifiers", [ "RULE_MODIFIERS"; "" ]
      "priority", [ "_DOT NUMBER"; "" ]
      "expansions", [ "_expansions" ]
      "_expansions", [ "alias"; "_expansions _OR alias"; "_expansions _NL_OR alias" ]
      "?alias", [ "expansion _TO nonterminal"; "expansion _TO STRING"; "expansion ignore_literals"; "expansion" ]
      "ignore_literals", [ "_IGNORE _literals" ]
      "_literals", [ "STRING"; "_literals _COMMA STRING" ]
      "expansion", [ "_expansion" ]
      "_expansion", [ ""; "_expansion expr" ]
      "?expr", [ "atom"; "atom OP"; "atom TILDE NUMBER"; "atom TILDE NUMBER _DOTDOT NUMBER" ]
      "?atom", [ "_LPAR expansions _RPAR"; "maybe"; "value" ]
      "value", [ "terminal"; "nonterminal"; "literal"; "range" ]
      "terminal", [ "TERMINAL" ]
      "nonterminal", [ "RULE" ]
      "?name", [ "RULE"; "TERMINAL" ]
      "?symbol", [ "terminal"; "nonterminal" ]
      "maybe", [ "_LBRA expansions _RBRA" ]
      "range", [ "STRING _DOTDOT STRING" ]
      "term", [ "TERMINAL _COLON expansions _NL"; "TERMINAL _DOT NUMBER _COLON expansions _NL" ]
      "override", [ "_OVERRIDE rule"; "_OVERRIDE term" ]
      "extend", [ "_EXTEND rule"; "_EXTEND term" ]
      "ignore", [ "_IGNORE expansions _NL"; "_IGNORE _ignore_list _NL" ]
      "_ignore_list", [ "expansion _COMMA expansion"; "_ignore_list _COMMA expansion" ]
      "ast_ignore", [ "_IGNORE _COLON _literals _NL" ]
      "declare", [ "_DECLARE _declare_args _NL" ]
      "import", [ "_IMPORT _import_list _NL" ]
      "_import_list", [ "import_item"; "_import_list _COMMA import_item" ]
      "import_item", [ "_import_path"; "_import_path _LPAR name_list _RPAR"; "_import_path _TO name" ]
      "_import_path", [ "import_lib"; "import_rel" ]
      "import_lib", [ "_import_args" ]
      "import_rel", [ "_DOT _import_args" ]
      "_import_args", [ "name"; "_import_args _DOT name" ]
      "name_list", [ "_name_list" ]
      "_name_list", [ "name"; "_name_list _COMMA name" ]
      "_declare_args", [ "symbol"; "_declare_args symbol" ]
      "literal", [ "REGEXP"; "STRING" ] ]

let symbolFromStrcase (s: string) =
    if isUpper s then terminal (s.StartsWith "_") None s else nonterminal s

type MetaParser =
    { MTable: ParseTable
      MRules: Rule array
      MCallbacks: (GNode list -> GNode) array
      MLexer: BasicLexer
      MConf: LexerConf }

let metaParser : Lazy<MetaParser> =
    lazy
        (let rulesWithOptions =
            metaRules |> List.collect (fun (name, alternatives) ->
                let expand1 = name.StartsWith "?"
                let name = if expand1 then name.Substring 1 else name
                alternatives |> List.mapi (fun i x ->
                    let symbols = x.Split(' ') |> Array.filter (fun s -> s <> "") |> Array.map symbolFromStrcase |> List.ofArray
                    { Origin = name; Expansion = symbols; Order = i; Priority = None; Ast = None }, expand1))
         let a = build false None (List.map fst rulesWithOptions) "start"
         if not (List.forall (fun c -> c.Resolved) a.Conflicts) then failwith "Larkita: conflicts in the meta-grammar"
         let callback (rule: Rule, expand1: bool) : GNode list -> GNode =
             let toInclude =
                 rule.Expansion |> List.indexed |> List.choose (fun (i, sym) ->
                     if sym.IsTerm && sym.FilterOut then None
                     else Some(i, (not sym.IsTerm) && sym.Name.StartsWith "_"))
             fun children ->
                 let children = Array.ofList children
                 let filtered =
                     toInclude |> List.collect (fun (i, toExpand) -> if toExpand then (treeOf children.[i]).Children else [ children.[i] ])
                 match filtered with
                 | [ x ] when expand1 -> x
                 | _ -> mkt rule.Origin filtered
         let callbacks = Array.ofList ((fun _ -> failwith "root") :: List.map callback rulesWithOptions)
         let terminals = metaTerminals |> List.map (fun (name, value) -> terminalDef 0 name (patternRe None "" value))
         let conf = lexerConf "" terminals [ "WS"; "COMMENT"; "BACKSLASH" ]
         { MTable = parseTable a; MRules = a.Rules; MCallbacks = callbacks; MLexer = basicLexer conf; MConf = conf })

let metaParse (text: string) : GNode =
    let m = metaParser.Value
    let st = lexerState text
    parse m.MTable m.MRules m.MCallbacks Tk (fun state -> nextToken m.MLexer st (Some state)) (formatExpected m.MConf.TerminalsByName)

// ---------- Error messages for grammar files ----------

let grammarErrors =
    [ "Incorrect type of value", [ "a: 1\n" ]
      "Unclosed parenthesis", [ "a: (\n" ]
      "Unmatched closing parenthesis", [ "a: )\n"; "a: [)\n"; "a: (]\n" ]
      "Expecting rule or terminal definition (missing colon)", [ "a\n"; "A\n"; "a->\n"; "A->\n"; "a A\n" ]
      "Illegal name for rules or terminals", [ "Aa:\n" ]
      "Unexpected colon", [ "a::\n"; "a: b:\n"; "a: B:\n"; "a: \"a\":\n" ]
      "Misplaced operator", [ "a: b??"; "a: b(?)"; "a:+\n"; "a:?\n"; "a:*\n"; "a:|*\n" ]
      "Expecting option (\"|\") or a new rule or terminal definition", [ "a:a\n()\n" ]
      "Terminal names cannot contain dots", [ "A.B\n" ]
      "Expecting rule or terminal definition",
      [ "\"a\"\n"; "a: A\n\"a\"\n"; "A: \"a\"\n\"a\"\n"; "%import common.A\n\"a\"\n"; "%ignore A\n\"a\"\n" ]
      "%import expects a name", [ "%import \"a\"\n"; "%import a.B, \"a\"\n"; "%import a.B,\n" ]
      "%ignore expects a value", [ "%ignore %import\n" ]
      "The elements of a list after %ignore cannot contain \"|\" or \"->\"",
      [ "%ignore A, B | C\n"; "%ignore A, B -> c\n"; "%ignore A, B, C | D\n"; "%ignore A, B, C -> d\n" ] ]

let grammarErrorsInAllPositions =
    grammarErrors |> List.map (fun (label, examples) ->
        label, examples |> List.collect (fun example -> [ ""; "A: \"a\"\n" ] |> List.map (fun first -> first + example)))

let tokenSpecificErrors =
    [ "Incorrect type of value", [ "NUMBER" ]
      "Unmatched closing parenthesis", [ "_RPAR"; "_RBRA" ]
      "Unexpected colon", [ "_COLON" ]
      "Misplaced operator", [ "OP" ]
      "The elements of a list after %ignore cannot contain \"|\" or \"->\"", [ "_OR"; "_NL_OR"; "_TO" ] ]

let sameSet (a: string list) (b: string list) = Set.ofList a = Set.ofList b

exception private Found of string

/// UnexpectedInput.match_examples
let matchExamples (e: UnexpectedInputInfo) (examples: (string * string list) list) : string option =
    let mutable candidate = None
    try
        for label, example in examples do
            for malformed in example do
                try metaParse malformed |> ignore
                with UnexpectedInput ut ->
                    if ut.State = e.State then
                        let skip =
                            match e.Kind, ut.Kind with
                            | UnexpectedToken (t1, x1), UnexpectedToken (t2, x2) ->
                                if not (sameSet x1 x2) then true
                                elif t1.Type = t2.Type && t1.Value = t2.Value then raise (Found label)
                                else false
                            | _ -> false
                        if not skip && candidate.IsNone then candidate <- Some label
        candidate
    with Found label -> Some label

let translateParserException (e: UnexpectedInputInfo) (token: Token) (expected: string list) =
    let examples =
        grammarErrorsInAllPositions |> List.filter (fun (label, _) ->
            match List.tryFind (fun (l, _) -> l = label) tokenSpecificErrors with
            | Some (_, types) -> List.contains token.Type types
            | None -> true)
    match matchExamples e examples with
    | Some error -> Some error
    | None -> if List.contains "STRING" expected then Some "Expecting a value" else None

// ---------- Literals ----------

let private isIdStartChar (c: char) =
    c = '_'
    || match CharUnicodeInfo.GetUnicodeCategory c with
       | UnicodeCategory.UppercaseLetter | UnicodeCategory.LowercaseLetter | UnicodeCategory.TitlecaseLetter
       | UnicodeCategory.ModifierLetter | UnicodeCategory.OtherLetter | UnicodeCategory.NonSpacingMark
       | UnicodeCategory.SpacingCombiningMark | UnicodeCategory.ConnectorPunctuation -> true
       | _ -> false

let private isIdContinueChar (c: char) =
    isIdStartChar c
    || match CharUnicodeInfo.GetUnicodeCategory c with
       | UnicodeCategory.DecimalDigitNumber | UnicodeCategory.LetterNumber -> true
       | _ -> false

/// the value of a Python string literal u'''w''' (ast.literal_eval)
let pythonUnescape (w: string) =
    let n = w.Length
    let b = StringBuilder()
    let isHex (c: char) = Uri.IsHexDigit c
    let hex i k =
        if i + k > n || not (Seq.forall isHex (w.Substring(i, k))) then
            raise (GrammarError("Cannot decode the escape sequence in " + w))
        Convert.ToInt32(w.Substring(i, k), 16)
    let add (c: int) = b.Append(Char.ConvertFromUtf32 c) |> ignore
    let mutable i = 0
    while i < n do
        let c = w.[i]
        if c = '\\' && i + 1 < n then
            let d = w.[i + 1]
            i <- i + 2
            match d with
            | '\\' -> add 92
            | '\'' -> add 39
            | '"' -> add 34
            | 'a' -> add 7
            | 'b' -> add 8
            | 'f' -> add 12
            | 'n' -> add 10
            | 'r' -> add 13
            | 't' -> add 9
            | 'v' -> add 11
            | '\n' -> ()
            | 'x' ->
                add (hex i 2)
                i <- i + 2
            | 'u' ->
                add (hex i 4)
                i <- i + 4
            | 'U' ->
                add (hex i 8)
                i <- i + 8
            | d when d >= '0' && d <= '7' ->
                let mutable v = int d - 48
                let mutable k = 0
                while k < 2 && i < n && w.[i] >= '0' && w.[i] <= '7' do
                    v <- v * 8 + (int w.[i] - 48)
                    i <- i + 1
                    k <- k + 1
                add v
            | d -> b.Append('\\').Append(d) |> ignore
        else
            b.Append c |> ignore
            i <- i + 1
    b.ToString()

let evalEscaping (s: string) =
    let w = StringBuilder()
    let mutable i = 0
    while i < s.Length do
        let n = s.[i]
        w.Append n |> ignore
        i <- i + 1
        if n = '\\' then
            if i >= s.Length then raise (GrammarError(sprintf "Literal ended unexpectedly (bad escaping): `%s`" (pyRepr s)))
            let n2 = s.[i]
            i <- i + 1
            if n2 = '\\' then w.Append "\\\\" |> ignore
            elif not ("Uuxnftr".Contains n2) then w.Append '\\' |> ignore
            w.Append n2 |> ignore
    let w = w.ToString().Replace("\\\"", "\"").Replace("'", "\\'")
    pythonUnescape w

let literalToPattern (literal: Token) : Pattern =
    let v = literal.Value
    let flagStart = max (v.LastIndexOf '/') (v.LastIndexOf '"') + 1
    let flags = v.Substring flagStart
    if literal.Type = "STRING" && v.Contains '\n' then raise (GrammarError "You cannot put newlines in string literals")
    if literal.Type = "REGEXP" && v.Contains '\n' && not (flags.Contains 'x') then
        raise (GrammarError "You can only use newlines in regular expressions with the `x` (verbose) flag")
    let v = v.Substring(0, flagStart)
    let x = v.Substring(1, v.Length - 2)
    let s = evalEscaping x
    if s = "" then raise (GrammarError(sprintf "Empty terminals are not allowed (%s)" literal.Value))
    if literal.Type = "STRING" then patternStr (Some literal.Value) flags (s.Replace("\\\\", "\\"))
    else patternRe (Some literal.Value) flags s

/// the text of a string literal token, e.g. ":=" for the token "\":=\""
let literalText (literal: Token) = (literalToPattern literal).Value

// ---------- Terminals: trees to patterns ----------

/// PrepareLiterals
let prepareLiterals (t: GTree) : GNode =
    match t.Data, t.Children with
    | "literal", [ Tk l ] -> mkt "pattern" [ Pt(literalToPattern l) ]
    | "child_literal", [ Tk l ] -> mkt "child_pattern" [ Pt(literalToPattern l) ]
    | "range", [ Tk s; Tk e ] ->
        let inner (v: string) = v.Substring(1, v.Length - 2)
        if (evalEscaping (inner s.Value)).Length <> 1 || (evalEscaping (inner e.Value)).Length <> 1 then
            raise (GrammarError "A range must consist of single characters")
        mkt "pattern" [ Pt(patternRe None "" (sprintf "[%s-%s]" (inner s.Value) (inner e.Value))) ]
    | _ -> T t

/// TerminalTreeToPattern
let rec terminalTreeToPattern (data: string) (children: GNode list) : GNode =
    let pat n = match n with Pt p -> p | _ -> failwith "Larkita: pattern expected"
    match data with
    | "pattern" -> List.head children
    | "expansion" ->
        match children with
        | [] -> Pt(patternStr None "" "")
        | [ p ] -> p
        | items -> Pt(patternRe None "" (String.Join("", items |> List.map (pat >> toRegexp))))
    | "expansions" ->
        match children with
        | [ p ] -> p
        | exps ->
            let exps = exps |> List.map pat |> List.sortBy (fun p -> -(maxWidth p), -(minWidth p), -p.Value.Length)
            Pt(patternRe None "" ("(?:" + String.Join("|", exps |> List.map toRegexp) + ")"))
    | "expr" ->
        let inner = pat (List.head children)
        let op = tokValue (List.item 1 children)
        let op =
            if op = "~" then
                match drop 2 children |> List.map tokValue with
                | [ k ] -> sprintf "{%d}" (int k)
                | [ mn; mx ] ->
                    let mn, mx = int mn, int mx
                    if mx < mn then raise (GrammarError(sprintf "Bad Range for %s (%d..%d isn't allowed)" (patternRepr inner) mn mx))
                    sprintf "{%d,%d}" mn mx
                | _ -> failwith "Larkita: bad range"
            else op
        Pt(patternRe None inner.Flags (sprintf "(?:%s)%s" (toRegexp inner) op))
    | "maybe" ->
        let q = { Type = "OP"; Value = "?"; StartPos = 0; Line = 0; Column = 0; EndLine = 0; EndColumn = 0; EndPos = 0 }
        terminalTreeToPattern "expr" (children @ [ Tk q ])
    | "alias" -> raise (GrammarError "Aliases (->) and %ignore annotations are not allowed in terminals")
    | "value" -> List.head children
    | _ -> mkt data children

// ---------- The abstract syntax trees of the alternatives ----------

/// _make_ast_spec: the head consists of all string literals of the alternative that are not ignored
let makeAstSpec (ruleName: string) (expansion: GTree) (ignore: string list) (alias: string option) : AstSpec =
    let literals = ResizeArray<string>()
    let mutable symbols = 0
    let mutable isSimple = true
    let rec visit (node: GNode) =
        match node with
        | Sy _ -> symbols <- symbols + 1
        | T t ->
            if t.Data = "alias" then
                raise (GrammarError(sprintf "In rule %s: an alias (->) or an %%ignore annotation can only be given at the end of an alternative" ruleName))
            match t.Data, t.Children with
            | "literal", [ Tk token ] ->
                if token.Type = "STRING" then
                    let text = literalText token
                    if not (List.contains text ignore) then literals.Add text
                else symbols <- symbols + 1
            | ("child_literal" | "range"), _ -> symbols <- symbols + 1
            | _ ->
                if t.Data = "expr" || t.Data = "maybe" || (t.Data = "expansions" && List.length t.Children > 1) then isSimple <- false
                for c in t.Children do
                    match c with
                    | T _ | Sy _ -> visit c
                    | _ -> ()
        | _ -> ()
    visit (T expansion)
    match alias with
    | Some a -> astSpec (Some [ a ])
    | None ->
        if literals.Count > 0 then astSpec (Some(List.ofSeq literals))
        elif symbols = 1 && isSimple then astSpec None
        else astSpec (Some [ ruleName ])

/// _expand_alternatives: the alternatives that the inner alternatives of tree abbreviate
let rec expandAlternatives (t: GTree) : GTree list =
    match t.Data with
    | "expansions" -> t.Children |> List.collect (fun c -> expandAlternatives (treeOf c))
    | "expansion" ->
        let variants =
            t.Children |> List.fold (fun variants child ->
                let options =
                    match child with
                    | T c when c.Data = "expansion" || c.Data = "expansions" -> expandAlternatives c |> List.map T
                    | c -> [ c ]
                variants |> List.collect (fun variant -> options |> List.map (fun option -> variant @ [ option ]))) [ [] ]
        variants |> List.map (mk "expansion")
    | _ -> [ t ]

/// _mark_child_literals
let rec markChildLiterals (inside: bool) (t: GTree) (ignore: string list) =
    for c in t.Children do
        match c with
        | T child ->
            if child.Data = "literal" then
                match child.Children with
                | [ Tk token ] when inside && token.Type = "STRING" && not (List.contains (literalText token) ignore) ->
                    child.Data <- "child_literal"
                | _ -> ()
            else markChildLiterals (inside || (child.Data = "expansions" && List.length child.Children > 1)) child ignore
        | _ -> ()

/// _attach_ast_specs
let attachAstSpecs (ruleName: string) (t: GTree) (astIgnore: string list) =
    while expandKidsByData t [ "expansions" ] do ()
    let alternatives =
        t.Children |> List.collect (fun alternative ->
            let alternative = treeOf alternative
            let expansion, alias, ignore =
                if alternative.Data = "alias" then
                    match alternative.Children with
                    | [ T expansion; T arg ] when arg.Data = "ignore_literals" ->
                        expansion, None, astIgnore @ (arg.Children |> List.map (function Tk t -> literalText t | _ -> failwith "literal"))
                    | [ T expansion; Tk arg ] -> expansion, Some(literalText arg), astIgnore
                    | [ T expansion; Sy arg ] -> expansion, Some arg.Name, astIgnore
                    | _ -> failwith "Larkita: bad alias"
                else alternative, None, astIgnore
            let variants =
                match alias with
                | None -> expandAlternatives expansion |> dedupWith (fun a b -> nodeEqual (T a) (T b)) |> List.map copyTree
                | Some _ -> [ expansion ]
            variants |> List.map (fun variant ->
                markChildLiterals false variant ignore
                mkt "alias" [ T variant; Sp(makeAstSpec ruleName variant ignore alias) ]))
    t.Children <- alternatives

// ---------- Anonymous terminals (PrepareAnonTerminals) ----------

let terminalNames =
    dict [ ".", "DOT"; ",", "COMMA"; ":", "COLON"; ";", "SEMICOLON"; "+", "PLUS"; "-", "MINUS"; "*", "STAR"
           "/", "SLASH"; "\\", "BACKSLASH"; "|", "VBAR"; "?", "QMARK"; "!", "BANG"; "@", "AT"; "#", "HASH"
           "$", "DOLLAR"; "%", "PERCENT"; "^", "CIRCUMFLEX"; "&", "AMPERSAND"; "_", "UNDERSCORE"
           "<", "LESSTHAN"; ">", "MORETHAN"; "=", "EQUAL"; "\"", "DBLQUOTE"; "'", "QUOTE"; "`", "BACKQUOTE"
           "~", "TILDE"; "(", "LPAR"; ")", "RPAR"; "{", "LBRACE"; "}", "RBRACE"; "[", "LSQB"; "]", "RSQB"
           "\n", "NEWLINE"; "\r\n", "CRLF"; "\t", "TAB"; " ", "SPACE" ]

type Anon =
    { mutable Terminals: TerminalDef list
      TermSet: HashSet<string>
      mutable TermReverse: (Pattern * TerminalDef) list    // the last definition of a pattern comes first
      mutable AnonI: int }

let makeAnon (terminals: TerminalDef list) =
    { Terminals = terminals
      TermSet = HashSet(terminals |> List.map (fun t -> t.Name))
      TermReverse = terminals |> List.rev |> List.map (fun t -> t.Pattern, t)
      AnonI = 0 }

let terminalName (an: Anon) (p: Pattern) =
    let find p = an.TermReverse |> List.tryPick (fun (q, td) -> if patternEqual p q then Some td else None)
    let termName =
        if p.IsStr then
            match find p with
            | Some td -> Some td.Name
            | None ->
                let name =
                    match terminalNames.TryGetValue p.Value with
                    | true, n -> Some n
                    | _ ->
                        if p.Value <> "" && Seq.forall isIdContinueChar p.Value && isIdStartChar p.Value.[0]
                           && not (an.TermSet.Contains(toUpper p.Value)) then Some(toUpper p.Value)
                        else None
                match name with
                | Some n when an.TermSet.Contains n -> None
                | n -> n
        else find p |> Option.map (fun td -> td.Name)
    let termName =
        match termName with
        | Some n -> n
        | None ->
            let n = sprintf "__ANON_%d" an.AnonI
            an.AnonI <- an.AnonI + 1
            n
    if an.TermSet.Add termName then
        let td = terminalDef 0 termName p
        td.FromLiteral <- true
        an.TermReverse <- (p, td) :: an.TermReverse
        an.Terminals <- an.Terminals @ [ td ]
    termName

let prepareAnon (an: Anon) (t: GTree) : GNode =
    match t.Data, t.Children with
    | "pattern", [ Pt p ] -> Sy(terminal p.IsStr None (terminalName an p))
    | "child_pattern", [ Pt p ] ->
        if not p.IsStr then failwith "Larkita: child_pattern expects a string"
        Sy(terminal false (Some p.Value) (terminalName an p))
    | _ -> T t

/// ValidateSymbols
let validateSymbols (t: GTree) : GNode =
    match t.Data, t.Children with
    | "value", [ v ] -> v
    | _ -> T t

// ---------- EBNF to BNF ----------

let smallFactorThreshold = 5
let repeatBreakThreshold = 50

let rec smallFactors (n: int) (maxFactor: int) : (int * int) list =
    if n <= maxFactor then [ n, 0 ]
    else
        let rec tryA a =
            if a <= 1 then failwith "Failed to factorize"
            else
                let r, b = n / a, n % a
                if a + b <= maxFactor then smallFactors r maxFactor @ [ a, b ] else tryA (a - 1)
        tryA maxFactor

type Ebnf =
    { mutable NewRules: (string * GTree) list
      mutable RulesCache: ((GNode * string list * string) * GNode) list
      mutable Prefix: string
      mutable I: int }

let terminalKinds (n: GNode) =
    match n with
    | Sy s when s.IsTerm -> [ symbolFullrepr s ]
    | T t -> scanValues (function Sy s -> s.IsTerm | _ -> false) t |> List.map (function Sy s -> symbolFullrepr s | _ -> "")
    | _ -> []

let ebnfTransform (e: Ebnf) (t: GTree) : GNode =
    let nameRule inner =
        let n = sprintf "__%s_%s_%d" e.Prefix inner e.I
        e.I <- e.I + 1
        n
    let cached (k', kinds', tag') =
        e.RulesCache |> List.tryPick (fun ((k, kinds, tag), v) -> if tag = tag' && kinds = kinds' && nodeEqual k k' then Some v else None)
    let addRule key name tree =
        let t = Sy(nonterminal name)
        e.NewRules <- e.NewRules @ [ name, tree ]
        e.RulesCache <- e.RulesCache @ [ key, t ]
        t
    let addRecurseRule type_ expr =
        let key = expr, terminalKinds expr, "recurse"
        match cached key with
        | Some t -> t
        | None ->
            let name = nameRule type_
            let t = Sy(nonterminal name)
            addRule key name (mk "expansions" [ mkt "expansion" [ expr ]; mkt "expansion" [ t; expr ] ])
    let addRepeatRule a b target atom =
        let key = mkt "repeat" [ target; atom ], terminalKinds atom, sprintf "repeat %d %d" a b
        match cached key with
        | Some t -> t
        | None ->
            let name = nameRule (sprintf "repeat_a%d_b%d" a b)
            addRule key name (mk "expansions" [ mkt "expansion" (List.replicate a target @ List.replicate b atom) ])
    let addRepeatOptRule a b target targetOpt atom =
        let key = mkt "repeat" [ target; atom ], terminalKinds atom, sprintf "opt %d %d" a b
        match cached key with
        | Some t -> t
        | None ->
            let name = nameRule (sprintf "repeat_a%d_b%d_opt" a b)
            let tree =
                mk "expansions"
                    (List.init a (fun i -> mkt "expansion" (List.replicate i target @ [ targetOpt ]))
                     @ List.init b (fun i -> mkt "expansion" (List.replicate a target @ List.replicate i atom)))
            addRule key name tree
    let generateRepeats rule mn mx =
        if mx < repeatBreakThreshold then
            mkt "expansions" (List.init (mx - mn + 1) (fun k -> mkt "expansion" (List.replicate (mn + k) rule)))
        else
            let mnTarget = smallFactors mn smallFactorThreshold |> List.fold (fun tg (a, b) -> addRepeatRule a b tg rule) rule
            if mx = mn then mnTarget
            else
                let diff = mx - mn + 1
                let factors = smallFactors diff smallFactorThreshold
                let mutable diffTarget = rule
                let mutable diffOptTarget = mkt "expansion" []
                for a, b in take (List.length factors - 1) factors do
                    diffOptTarget <- addRepeatOptRule a b diffTarget diffOptTarget rule
                    diffTarget <- addRepeatRule a b diffTarget rule
                let a, b = List.last factors
                let diffOptTarget = addRepeatOptRule a b diffTarget diffOptTarget rule
                mkt "expansions" [ mkt "expansion" [ mnTarget; diffOptTarget ] ]
    match t.Data with
    | "expr" ->
        let rule = List.head t.Children
        match tokValue (List.item 1 t.Children) with
        | "?" -> mkt "expansions" [ rule; mkt "expansion" [] ]
        | "+" -> addRecurseRule "plus" rule
        | "*" -> mkt "expansions" [ addRecurseRule "star" rule; mkt "expansion" [] ]
        | "~" ->
            let mn, mx =
                match drop 2 t.Children |> List.map (tokValue >> int) with
                | [ k ] -> k, k
                | [ mn; mx ] ->
                    if mx < mn || mn < 0 then raise (GrammarError(sprintf "Bad Range for %s (%d..%d isn't allowed)" "rule" mn mx))
                    mn, mx
                | _ -> failwith "Larkita: bad range"
            generateRepeats rule mn mx
        | op -> failwith ("Larkita: unknown operator " + op)
    | "maybe" -> mkt "expansions" [ List.head t.Children; mkt "expansion" [] ]
    | _ -> T t

// ---------- Simplification (SimplifyRule_Visitor) ----------

let rec simplify (t: GTree) = iterSubtrees t |> List.iter simplifyNode

and flatten (t: GTree) = while expandKidsByData t [ t.Data ] do ()

and simplifyNode (t: GTree) =
    match t.Data with
    | "expansion" ->
        flatten t
        let others = t.Children
        match others |> List.tryFindIndex (function T c -> c.Data = "expansions" | _ -> false) with
        | Some i ->
            let child = treeOf (List.item i others)
            t.Data <- "expansions"
            t.Children <-
                child.Children
                |> dedupWith nodeEqual
                |> List.map (fun option ->
                    let nt = mk "expansion" (others |> List.mapi (fun j other -> if j = i then option else other))
                    simplify nt
                    T nt)
            flatten t
        | None -> ()
    | "alias" ->
        match t.Children with
        | [ T rule; aliasName ] when rule.Data = "expansions" ->
            t.Data <- "expansions"
            t.Children <- rule.Children |> List.map (fun child -> mkt "alias" [ child; aliasName ])
        | _ -> ()
    | "expansions" ->
        flatten t
        let d = dedupWith nodeEqual t.Children
        if List.length d <> List.length t.Children then t.Children <- d
    | _ -> ()

/// RuleTreeToText: the alternatives of a rule as lists of symbols with their AstSpecs
let ruleTreeToText (t: GTree) : (Symbol list * AstSpec option) list =
    let symbols (e: GTree) = e.Children |> List.map (function Sy s -> s | _ -> failwith "Larkita: unexpected node in a rule")
    let rec alternatives (n: GNode) =
        match n with
        | T { Data = "expansions"; Children = children } -> List.collect alternatives children
        | T ({ Data = "expansion" } as e) -> [ symbols e, None ]
        | T { Data = "alias"; Children = [ T e; Sp spec ] } -> [ symbols e, Some spec ]
        | Sy s -> [ [ s ], None ]
        | _ -> failwith "Larkita: unexpected node in a rule"
    alternatives (T t)

// ---------- Grammars ----------

type Definition = { IsTerm: bool; mutable Tree: GTree option; Options: int option }

type Grammar =
    { RuleDefs: (string * GTree * int option) list
      TermDefs: (string * GTree option * int) list
      IgnoreNames: string list
      AstIgnore: string list
      FirstRule: string option }

let compileGrammar (g: Grammar) (start: string list) : TerminalDef list * Rule list * string list =
    let termDefs = g.TermDefs |> List.map (fun (n, t, p) -> n, Option.map copyTree t, p)
    let ruleDefs = g.RuleDefs |> List.map (fun (n, t, o) -> n, copyTree t, o)
    for name, t, _ in termDefs do
        match t with
        | Some t ->
            match findData t "expansion" with
            | [ e ] when List.isEmpty e.Children -> raise (GrammarError(sprintf "Terminals cannot be empty (%s)" name))
            | _ -> ()
        | None -> ()
    let terminals =
        termDefs |> List.choose (fun (name, t, priority) ->
            match t with
            | None -> None
            | Some t ->
                match transform terminalTreeToPattern (transformInPlace prepareLiterals t) with
                | Pt p -> Some(terminalDef priority name p)
                | _ -> failwith "Larkita: cannot compile terminal")
    // 1. the shape of the abstract syntax tree of every alternative
    for name, t, _ in ruleDefs do attachAstSpecs name t g.AstIgnore
    // 2. + 3. anonymous terminals and EBNF
    let an = makeAnon terminals
    let e = { NewRules = []; RulesCache = []; Prefix = "anon"; I = 0 }
    let rules =
        ruleDefs |> List.map (fun (name, t, options) ->
            e.Prefix <- name
            let t = treeOf (transformInPlace prepareLiterals t)
            let t = treeOf (transformInPlace validateSymbols t)
            let t = treeOf (transformInPlace (prepareAnon an) t)
            name, treeOf (transformInPlace (ebnfTransform e) t), options)
    let rules = rules @ (e.NewRules |> List.map (fun (name, t) -> name, t, None))
    // 4. compile the trees to rules
    let compiled =
        rules |> List.collect (fun (name, t, priority) ->
            simplify t
            ruleTreeToText t |> List.mapi (fun i (expansion, spec) ->
                { Origin = name; Expansion = expansion; Order = i; Priority = priority; Ast = spec }))
    let compiled =
        if List.length (dedupWith ruleEqual compiled) <> List.length compiled then
            for r in compiled do
                let dups = compiled |> List.filter (ruleEqual r)
                if List.length dups > 1 && not (List.isEmpty r.Expansion) then
                    raise (GrammarError(
                        "Rules defined twice: " + String.Join("", dups |> List.map (fun d -> "\n  * " + ruleToString d))
                        + "\n\n(Might happen due to colliding expansion of optionals: [] or ?)"))
            dedupWith ruleEqual compiled
        else compiled
    // unused rules
    let rec filterUnused compiled =
        let used =
            (compiled |> List.collect (fun r -> r.Expansion |> List.choose (fun s -> if not s.IsTerm && s.Name <> r.Origin then Some s.Name else None)))
            @ start
        let kept = compiled |> List.filter (fun r -> List.contains r.Origin used)
        if List.length kept = List.length compiled then kept else filterUnused kept
    let compiled = filterUnused compiled
    // unused terminals
    let usedTerms = compiled |> List.collect (fun r -> r.Expansion |> List.choose (fun s -> if s.IsTerm then Some s.Name else None))
    let terminals = an.Terminals |> List.filter (fun t -> List.contains t.Name usedTerms || List.contains t.Name g.IgnoreNames)
    terminals, compiled, g.IgnoreNames

// ---------- The grammar builder ----------

let mutable grammarsDir = "grammars"   // set by Larkita.fsx: the directory of common.lark

type Builder =
    { ImportPaths: string list
      mutable Definitions: (string * Definition) list
      mutable IgnoreList: string list
      mutable AstIgnoreList: string list
      mutable First: string option }

let newBuilder importPaths = { ImportPaths = importPaths; Definitions = []; IgnoreList = []; AstIgnoreList = []; First = None }

let grammarError (isTerm: bool) (msg: string) (names: string list) : 'a =
    let lower = if isTerm then "terminal" else "rule"
    let title = if isTerm then "Terminal" else "Rule"
    let mutable msg = msg
    names |> List.iteri (fun i name ->
        let postfix = if i = 0 then "" else string (i + 1)
        msg <- msg.Replace("{name" + postfix + "}", name).Replace("{type" + postfix + "}", lower).Replace("{Type" + postfix + "}", title))
    raise (GrammarError msg)

let hasDef (b: Builder) name = List.exists (fun (n, _) -> n = name) b.Definitions
let getDef (b: Builder) name = b.Definitions |> List.tryFind (fun (n, _) -> n = name) |> Option.map snd

let define (overrideDef: bool) (b: Builder) (name: string) (isTerm: bool) (tree: GTree option) (options: int option) =
    if hasDef b name then
        if not overrideDef then grammarError isTerm "{Type} '{name}' defined more than once" [ name ]
    elif overrideDef then grammarError isTerm "Cannot override a nonexisting {type} {name}" [ name ]
    if name.StartsWith "__" then grammarError isTerm "Names starting with double-underscore are reserved (Error at {name})" [ name ]
    let options = if isTerm then Some(defaultArg options 1) else options
    let d = { IsTerm = isTerm; Tree = tree; Options = options }
    if hasDef b name then b.Definitions <- b.Definitions |> List.map (fun (n, d') -> if n = name then n, d else n, d')
    else b.Definitions <- b.Definitions @ [ name, d ]

let extend (b: Builder) (name: string) (isTerm: bool) (tree: GTree option) =
    match getDef b name with
    | None -> grammarError isTerm "Can't extend {type} {name} as it wasn't defined before" [ name ]
    | Some d ->
        if isTerm <> d.IsTerm then grammarError isTerm "Cannot extend {type} {name} - one is a terminal, while the other is not." [ name ]
        match d.Tree with
        | None -> grammarError isTerm "Can't extend {type} {name} - it is abstract." [ name ]
        | Some baseTree -> baseTree.Children <- T tree.Value :: baseTree.Children

let ignoreItem (b: Builder) (t: GTree) =
    let t = if t.Data = "expansion" then mk "expansions" [ T t ] else t
    let singleTerminal =
        match t with
        | { Data = "expansions"; Children = [ T { Data = "expansion"; Children = [ T { Data = "value"; Children = [ Sy s ] } ] } ] } when s.IsTerm ->
            Some s.Name
        | _ -> None
    match singleTerminal with
    | Some name -> b.IgnoreList <- b.IgnoreList @ [ name ]
    | None ->
        let name = sprintf "__IGNORE_%d" (List.length b.IgnoreList)
        b.IgnoreList <- b.IgnoreList @ [ name ]
        b.Definitions <- b.Definitions @ [ name, { IsTerm = true; Tree = Some t; Options = Some 0 } ]

/// the names of the symbols in the order of their first occurrence
let findUsedSymbols (t: GTree) =
    iterSubtreesTopdown t
    |> List.collect (fun x ->
        if x.Data = "expansion" then scanValues (function Sy _ -> true | _ -> false) x |> List.map (function Sy s -> s.Name | _ -> "")
        else [])
    |> dedup

let resolveTermReferences (termDict: (string * GTree option) list) =
    let mutable changed = true
    while changed do
        changed <- false
        for name, t in termDict do
            match t with
            | None -> ()
            | Some t ->
                for exp in findData t "value" do
                    match exp.Children with
                    | [ Sy item ] when not item.IsTerm ->
                        raise (GrammarError(sprintf "Rules aren't allowed inside terminals (NonTerminal(%s) in %s)" (pyRepr item.Name) name))
                    | [ Sy item ] ->
                        match termDict |> List.tryFind (fun (n, _) -> n = item.Name) with
                        | None | Some (_, None) -> raise (GrammarError("Terminal used but not defined: " + item.Name))
                        | Some (_, Some value) ->
                            exp.Children <- [ T value ]
                            changed <- true
                    | _ -> ()
    for name, t in termDict do
        match t with
        | None -> ()
        | Some term ->
            for child in term.Children do
                match child with
                | T c ->
                    if iterSubtrees c |> List.exists (fun s -> obj.ReferenceEquals(s, term)) then
                        raise (GrammarError(sprintf "Recursion in terminal '%s' (recursion is only allowed in rules, not terminals)" name))
                | _ -> ()

let parseGrammar (text: string) (name: string) : GTree =
    let tree =
        try metaParse (text + "\n")
        with UnexpectedInput e ->
            let context = getContext 40 e text
            match e.Kind with
            | UnexpectedCharacters _ ->
                raise (GrammarError(sprintf "Unexpected input at line %d column %d in %s: \n\n%s" e.Line e.Column name context))
            | UnexpectedToken (token, expected) ->
                match translateParserException e token expected with
                | Some error -> raise (GrammarError(sprintf "%s, at line %d column %d\n\n%s" error e.Line e.Column context))
                | None -> raise (UnexpectedInput e)
    // PrepareGrammar
    transformInPlace
        (fun t ->
            match t.Data, t.Children with
            | "terminal", [ Tk name ] -> Sy(terminal false None name.Value)
            | "nonterminal", [ Tk name ] -> Sy(nonterminal name.Value)
            | _ -> T t)
        (treeOf tree)
    |> treeOf

let mangleDefinitionTree (exp: GTree) (mangle: (string -> string) option) =
    match mangle with
    | None -> exp
    | Some m ->
        let exp = copyTree exp
        for t in iterSubtrees exp do
            t.Children <- t.Children |> List.map (function Sy s -> Sy { s with Name = m s.Name } | c -> c)
        exp

let unpackDefinition (t: GTree) (mangle: (string -> string) option) =
    let name, isTerm, exp, opts =
        if t.Data = "rule" then
            match t.Children with
            | [ T modifiers; Tk name; T priority; T exp ] ->
                match modifiers.Children with
                | [ Tk m ] -> raise (GrammarError(sprintf "Rule modifiers like '%s' are not supported by Larkita (in rule %s)" m.Value name.Value))
                | _ -> ()
                let priority = match priority.Children with [ Tk p ] -> Some(int p.Value) | _ -> None
                name.Value, false, exp, priority
            | _ -> failwith "Larkita: bad rule"
        else
            match t.Children with
            | [ Tk name; T exp ] -> name.Value, true, exp, Some 0
            | [ Tk name; Tk p; T exp ] -> name.Value, true, exp, Some(int p.Value)
            | _ -> failwith "Larkita: bad terminal"
    let name = match mangle with Some m -> m name | None -> name
    name, isTerm, Some(mangleDefinitionTree exp mangle), opts

let getMangle (prefix: string) (aliases: (string * string) list) (baseMangle: (string -> string) option) =
    fun (s: string) ->
        let s =
            match List.tryFind (fun (k, _) -> k = s) aliases with
            | Some (_, a) -> a
            | None -> if s.StartsWith "_" then sprintf "_%s__%s" prefix (s.Substring 1) else sprintf "%s__%s" prefix s
        match baseMangle with Some m -> m s | None -> s

let rec load (b: Builder) (text: string) (grammarName: string) (mangle: (string -> string) option) =
    let tree = parseGrammar text grammarName
    // the imports
    let imports = ResizeArray<string list * (string option * (string * string) list ref)>()
    for stmt in tree.Children do
        match stmt with
        | T { Data = "import"; Children = children } ->
            for item in children do
                let item = treeOf item
                let pathNode, arg1 =
                    match item.Children with
                    | [ T p ] -> p, None
                    | [ T p; a ] -> p, Some a
                    | _ -> failwith "Larkita: bad import"
                let names = pathNode.Children |> List.map tokValue
                let dottedPath, aliases =
                    match arg1 with
                    | Some (T nameList) ->
                        let ns = nameList.Children |> List.map tokValue
                        names, ns |> List.map (fun n -> n, n)
                    | _ ->
                        let dotted = take (List.length names - 1) names
                        if List.isEmpty dotted then raise (GrammarError(sprintf "Nothing was imported from grammar `%s`" (List.head names)))
                        let name = List.last names
                        let alias = match arg1 with Some (Tk a) -> a.Value | _ -> name
                        dotted, [ name, alias ]
                let basePath =
                    if pathNode.Data = "import_lib" then None
                    elif grammarName = "<string>" then Some(IO.Directory.GetCurrentDirectory())
                    else Some(IO.Path.GetDirectoryName(IO.Path.GetFullPath grammarName))
                match Seq.tryFind (fun (p, _) -> p = dottedPath) imports with
                | Some (_, (_, al)) -> al.Value <- aliases |> List.fold (fun acc (k, v) -> (acc |> List.filter (fun (k', _) -> k' <> k)) @ [ k, v ]) al.Value
                | None -> imports.Add(dottedPath, (basePath, ref aliases))
        | _ -> ()
    for dottedPath, (basePath, aliases) in imports do doImport b dottedPath basePath aliases.Value mangle
    // the definitions
    for stmt in tree.Children do
        let stmt = treeOf stmt
        match stmt.Data with
        | "term" | "rule" ->
            let name, isTerm, exp, opts = unpackDefinition stmt mangle
            define false b name isTerm exp opts
            if stmt.Data = "rule" && mangle.IsNone && b.First.IsNone then b.First <- Some name
        | "override" ->
            let name, isTerm, exp, opts = unpackDefinition (treeOf (List.head stmt.Children)) mangle
            define true b name isTerm exp opts
        | "extend" ->
            let name, isTerm, exp, _ = unpackDefinition (treeOf (List.head stmt.Children)) mangle
            extend b name isTerm exp
        | "ignore" -> if mangle.IsNone then for i in stmt.Children do ignoreItem b (treeOf i)
        | "ast_ignore" ->
            if mangle.IsNone then
                b.AstIgnoreList <- b.AstIgnoreList @ (stmt.Children |> List.map (function Tk t -> literalText t | _ -> failwith "literal"))
        | "declare" ->
            for c in stmt.Children do
                match c with
                | Sy s ->
                    if not s.IsTerm then
                        raise (GrammarError(sprintf "Expecting terminal name to follow %%declare, but got rule name %s" (pyRepr s.Name)))
                    let name = match mangle with Some m -> m s.Name | None -> s.Name
                    define false b name true None None
                | _ -> failwith "Larkita: bad declare"
        | "import" -> ()
        | d -> failwith ("Larkita: unexpected statement " + d)
    resolveTermReferences (b.Definitions |> List.choose (fun (n, d) -> if d.IsTerm then Some(n, d.Tree) else None))

and removeUnused (b: Builder) (used: string list) =
    let deps symbol =
        match getDef b symbol with
        | Some { IsTerm = false; Tree = Some t } -> findUsedSymbols t
        | _ -> []
    let visited = HashSet<string>()
    let queue = Queue<string>()
    for u in used do
        if visited.Add u then queue.Enqueue u
    while queue.Count > 0 do
        let node = queue.Dequeue()
        for n in deps node do
            if visited.Add n then queue.Enqueue n
    b.Definitions <- b.Definitions |> List.filter (fun (k, _) -> visited.Contains k)

and doImport (b: Builder) (dottedPath: string list) (basePath: string option) (aliases: (string * string) list) baseMangle =
    let mangle = getMangle (String.Join("__", dottedPath)) aliases baseMangle
    let grammarPath = IO.Path.Combine(Array.ofList dottedPath) + ".lark"
    let toTry = b.ImportPaths @ (match basePath with Some p -> [ p ] | None -> [ grammarsDir ])
    let found =
        toTry |> List.tryPick (fun dir ->
            let joined = IO.Path.Combine(dir, grammarPath)
            if IO.File.Exists joined then Some(joined, IO.File.ReadAllText joined) else None)
    match found with
    | None -> raise (IO.FileNotFoundException(sprintf "[Errno 2] No such file or directory: %s" (pyRepr grammarPath)))
    | Some (joined, text) ->
        let gb = newBuilder b.ImportPaths
        load gb text joined (Some mangle)
        removeUnused gb (aliases |> List.map (fun (k, _) -> mangle k))
        for name, _ in gb.Definitions do
            if hasDef b name then
                raise (GrammarError(sprintf "Cannot import '%s' from '%s': Symbol already defined." name grammarPath))
        b.Definitions <- b.Definitions @ gb.Definitions

let validate (b: Builder) =
    for name, d in b.Definitions do
        match d.Tree with
        | None -> ()
        | Some exp ->
            for sym in findUsedSymbols exp do
                if not (hasDef b sym) then grammarError d.IsTerm "{Type} '{name}' used but not defined (in {type2} {name2})" [ sym; name ]
    let undefined = dedup b.IgnoreList |> List.filter (fun n -> not (hasDef b n))
    if not (List.isEmpty undefined) then
        raise (GrammarError(sprintf "Terminals {%s} were marked to ignore but were not defined!" (String.Join(", ", List.map pyRepr undefined))))

let buildGrammar (b: Builder) : Grammar =
    validate b
    { RuleDefs = b.Definitions |> List.choose (fun (n, d) -> if d.IsTerm then None else Some(n, d.Tree.Value, d.Options))
      TermDefs = b.Definitions |> List.choose (fun (n, d) -> if d.IsTerm then Some(n, d.Tree, defaultArg d.Options 0) else None)
      IgnoreNames = b.IgnoreList
      AstIgnore = b.AstIgnoreList
      FirstRule = b.First }

let loadGrammar (text: string) (source: string) (importPaths: string list) : Grammar =
    let b = newBuilder importPaths
    load b text source None
    buildGrammar b
