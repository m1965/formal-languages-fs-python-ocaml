{
module LectureScanning.Arithmetic
open FSharp.Text.Lexing
open LectureScanning
let text lexbuf = LexBuffer<char>.LexemeString lexbuf
}
let digit = ['0'-'9']
let natural = '0' | ['1'-'9'] digit*
rule token = parse
| natural { Number(int (text lexbuf)) }
| ['+' '-' '*' '/' '(' ')'] { Symbol((text lexbuf).[0]) }
| [' ' '\t' '\r']+ { token lexbuf }
| '\n' { lexbuf.EndPos <- lexbuf.EndPos.NextLine; token lexbuf }
| eof { End }
| _ { Illegal((text lexbuf).[0]) }
