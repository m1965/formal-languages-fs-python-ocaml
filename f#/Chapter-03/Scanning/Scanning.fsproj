<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net9.0</TargetFramework><GenerateDocumentationFile>true</GenerateDocumentationFile></PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FsLexYacc" Version="11.3.0" />
    <PackageReference Include="FsLexYacc.Runtime" Version="11.3.0" />
    <Compile Include="Types.fs" />
    <FsLex Include="Arithmetic.fsl"><OtherFlags>--unicode</OtherFlags></FsLex>
    <FsLex Include="Exam.fsl"><OtherFlags>--unicode</OtherFlags></FsLex>
    <FsLex Include="Html.fsl"><OtherFlags>--unicode</OtherFlags></FsLex>
    <FsLex Include="Latex.fsl"><OtherFlags>--unicode</OtherFlags></FsLex>
    <Compile Include="Arithmetic.fs" /><Compile Include="Exam.fs" /><Compile Include="Html.fs" /><Compile Include="Latex.fs" /><Compile Include="Scanning.fs" />
  </ItemGroup>
</Project>
